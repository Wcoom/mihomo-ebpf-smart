+		if isUDP {
+			minUDP := r.avgASNWeight(WeightTypeUDP)
+			if minUDP > 0 {
+				r.weights.Set(WeightTypeUDP, minUDP)
+			}
+		} else {
+			minTCP := r.avgASNWeight(WeightTypeTCP)
