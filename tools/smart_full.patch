+func (r *AtomicStatsRecord) avgASNWeight(prefix string) float64 {
+	weights := r.weights.FilterByKeyPrefix(prefix)
+	var sum float64
+	var count int
+	for k, v := range weights {
+		if k == prefix {
+			continue
+		}
+		sum += v
+		count++
+	}
+	if count == 0 {
+		return 0.0
+	}
+	return sum / float64(count)
+}
