+		expectedStatus:       option.ExpectedStatus,
+		configName:           configName,
+		disableUDP:           option.DisableUDP,
+		policyPriority:       make([]priorityRule, 0),
+		sampleRate:           1,
+		useLightGBM:          smartOption.UseLightGBM,
+		collectData:          smartOption.CollectData,
